<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" spacing="0" styleClass="settings-root" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.du.et.chatapp.controllers.SettingsController" prefWidth="900" prefHeight="600">
    
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="floating">
        <tabs>
            <!-- General Settings Tab -->
            <Tab text="General">
                <graphic>
                    <Label fx:id="iconGeneralTab" />
                </graphic>
                <content>
                    <ScrollPane hbarPolicy="NEVER" fitToWidth="true" styleClass="chat-scroll-pane">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 24 32;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label fx:id="iconGeneralHeader" styleClass="accent" />
                                    <Label text="Application Settings" styleClass="title-3"/>
                                </HBox>

                                <VBox styleClass="settings-card">
                                    <VBox spacing="16">
                                        <HBox alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label text="Theme" styleClass="card-label"/>
                                                <Label text="Switch between light and dark mode" styleClass="card-description"/>
                                            </VBox>
                                            <ToggleButton fx:id="themeToggle" styleClass="button-icon">
                                                <graphic><Label fx:id="iconTheme" /></graphic>
                                            </ToggleButton>
                                        </HBox>

                                        <Separator/>

                                        <GridPane hgap="16" vgap="16">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="NEVER" minWidth="120"/>
                                                <ColumnConstraints hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <Label text="Font Family" styleClass="card-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                            <ComboBox fx:id="fontFamilyCombo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Font Size" styleClass="card-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                            <Spinner fx:id="fontSizeSpinner" min="8" max="24" initialValue="14" amountToStepBy="1" editable="true" prefWidth="120" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                        </GridPane>
                                    </VBox>
                                </VBox>

                                <VBox styleClass="settings-card">
                                    <VBox spacing="12">
                                        <VBox spacing="4">
                                            <Label text="System Prompt" styleClass="card-label"/>
                                            <Label text="The core instruction that defines AI behavior" styleClass="card-description"/>
                                        </VBox>
                                        <TextArea fx:id="systemPromptArea" wrapText="true" prefRowCount="3" styleClass="modern-text-field"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>

            <!-- Providers & Models Combined Tab -->
            <Tab text="Providers &amp; Models">
                <graphic>
                    <Label fx:id="iconProvidersTab" />
                </graphic>
                <content>
                    <ScrollPane hbarPolicy="NEVER" fitToWidth="true" styleClass="chat-scroll-pane">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 24 32;">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label fx:id="iconProvidersHeader" styleClass="accent" />
                                    <Label text="Provider Configuration" styleClass="title-3"/>
                                </HBox>

                                <VBox styleClass="settings-card">
                                    <VBox spacing="12">
                                        <HBox alignment="CENTER_LEFT" spacing="16">
                                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                <Label text="Active Provider" styleClass="card-label"/>
                                                <Label text="Select which AI service to use" styleClass="card-description"/>
                                            </VBox>
                                            <ChoiceBox fx:id="providerChoice" prefWidth="180" />
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <VBox styleClass="settings-card">
                                    <VBox spacing="12">
                                        <Label text="API &amp; Server Connectivity" styleClass="card-label"/>
                                        <VBox spacing="12">
                                            <!-- Ollama Config -->
                                            <VBox fx:id="ollamaConfigBox" spacing="8">
                                                <Label text="Ollama Host URL" styleClass="text-small text-bold"/>
                                                <TextField fx:id="ollamaHost" promptText="http://localhost:11434" />
                                            </VBox>

                                            <!-- Local Llama Config -->
                                            <VBox fx:id="localLlamaConfigBox" spacing="8" visible="false" managed="false">
                                                <Label text="Model Path (Auto-managed)" styleClass="text-small text-bold"/>
                                                <HBox spacing="8">
                                                    <TextField fx:id="localModelPathField" editable="false" promptText="Select a model below to see path" HBox.hgrow="ALWAYS" />
                                                    <Button fx:id="btnBrowseModel" onAction="#onBrowseModel" styleClass="button-icon">
                                                        <tooltip>
                                                            <Tooltip text="Import new GGUF model"/>
                                                        </tooltip>
                                                        <graphic><Label fx:id="iconBrowse" /></graphic>
                                                    </Button>
                                                </HBox>
                                            </VBox>

                                            <!-- OpenRouter Config -->
                                            <VBox fx:id="openRouterConfigBox" spacing="8" visible="false" managed="false">
                                                <Label text="OpenRouter API Key" styleClass="text-small text-bold"/>
                                                <HBox spacing="8">
                                                    <StackPane HBox.hgrow="ALWAYS">
                                                        <PasswordField fx:id="openRouterKeyField" promptText="sk-or-v1-..." />
                                                        <TextField fx:id="openRouterKeyText" visible="false" managed="false" />
                                                    </StackPane>
                                                    <ToggleButton fx:id="openRouterToggle" styleClass="button-icon">
                                                        <graphic><Label fx:id="iconOpenRouterEye" /></graphic>
                                                    </ToggleButton>
                                                </HBox>
                                            </VBox>

                                            <!-- Groq Config -->
                                            <VBox fx:id="groqConfigBox" spacing="8" visible="false" managed="false">
                                                <Label text="Groq API Key" styleClass="text-small text-bold"/>
                                                <HBox spacing="8">
                                                    <StackPane HBox.hgrow="ALWAYS">
                                                        <PasswordField fx:id="groqKeyField" promptText="gsk_..." />
                                                        <TextField fx:id="groqKeyText" visible="false" managed="false" />
                                                    </StackPane>
                                                    <ToggleButton fx:id="groqToggle" styleClass="button-icon">
                                                        <graphic><Label fx:id="iconGroqEye" /></graphic>
                                                    </ToggleButton>
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </VBox>
                                </VBox>

                                <!-- Integrated Model Management Section -->
                                <VBox spacing="12">
                                    <HBox alignment="CENTER_LEFT" spacing="12">
                                        <Label fx:id="iconModelsHeader" styleClass="accent" />
                                        <Label text="Model Selection" styleClass="title-3"/>
                                    </HBox>

                                    <HBox spacing="16">
                                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="settings-card">
                                            <Label text="Available Models" styleClass="card-label"/>
                                            <HBox alignment="CENTER_LEFT" spacing="8">
                                                <Label text="Selected:" styleClass="card-description"/>
                                                <Label fx:id="currentModelLabel" text="None" styleClass="text-bold text-accent"/>
                                            </HBox>
                                            <ListView fx:id="modelsList" prefHeight="180" minHeight="150" VBox.vgrow="ALWAYS" />
                                            <HBox spacing="8">
                                                <Button fx:id="btnRefreshModels" onAction="#onFetchModels" text="Refresh" styleClass="accent">
                                                    <graphic><Label fx:id="iconRefresh" /></graphic>
                                                </Button>
                                                <Button fx:id="btnDeleteModel" onAction="#onDeleteModel" text="Delete" styleClass="danger">
                                                    <graphic><Label fx:id="iconDelete" /></graphic>
                                                </Button>
                                            </HBox>
                                        </VBox>

                                        <VBox spacing="12" minWidth="280" styleClass="settings-card">
                                            <Label text="Add / Import" styleClass="card-label"/>
                                            <TextField fx:id="newModelField" promptText="Model name..." />
                                            <Button fx:id="btnAddModel" onAction="#onAddModel" text="Add Model" maxWidth="Infinity" styleClass="success">
                                                <graphic><Label fx:id="iconPlusCircle" /></graphic>
                                            </Button>

                                            <Separator/>

                                            <Button fx:id="btnImportGGUF" onAction="#onBrowseModel" text="Import GGUF" maxWidth="Infinity" styleClass="accent">
                                                <graphic><Label fx:id="iconFileImport" /></graphic>
                                            </Button>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </content>
            </Tab>
        </tabs>
    </TabPane>

    <!-- Footer Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 12 24; -fx-background-color: -color-bg-subtle; -fx-border-color: -color-border-subtle; -fx-border-width: 1 0 0 0;">
        <Button onAction="#onCancel" text="Cancel" />
        <Button fx:id="btnSave" onAction="#onSave" text="Save Changes" styleClass="accent">
            <graphic><Label fx:id="iconSave" /></graphic>
        </Button>
    </HBox>
</VBox>