<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" styleClass="prompts-root" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.du.et.chatapp.controllers.PromptsController" prefWidth="900" prefHeight="600">
    <HBox styleClass="title-bar" alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 12 16;">
        <Label fx:id="iconLibrary" styleClass="app-icon" />
        <Label text="Prompt Library" styleClass="app-title"/>
    </HBox>

    <Separator/>

    <HBox spacing="0" VBox.vgrow="ALWAYS">
        <!-- Sidebar -->
        <VBox styleClass="nav-panel" minWidth="280" maxWidth="280" spacing="16">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                 <TextField fx:id="searchField" promptText="Search prompts..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                 <Button fx:id="btnNewPrompt" onAction="#onNewPrompt" styleClass="window-button">
                     <graphic><Label fx:id="iconPlus" /></graphic>
                     <tooltip><Tooltip text="New Prompt"/></tooltip>
                 </Button>
            </HBox>
            
            <ListView fx:id="promptsList" VBox.vgrow="ALWAYS" styleClass="chat-history-list"/>
        </VBox>

        <!-- Main Content -->
        <VBox HBox.hgrow="ALWAYS" styleClass="main-content" spacing="20">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>
            
            <VBox spacing="8">
                <Label text="Title" styleClass="card-label"/>
                <TextField fx:id="titleField" promptText="Enter prompt title..." styleClass="modern-text-field"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Content" styleClass="card-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Supports Markdown &amp; {{variables}}" styleClass="card-description"/>
                </HBox>
                <TextArea fx:id="contentArea" promptText="Write your prompt here..." wrapText="true" VBox.vgrow="ALWAYS" styleClass="modern-text-field"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="deleteBtn" onAction="#onDelete" text="Delete" styleClass="danger-button" visible="false" managed="false">
                    <graphic><Label fx:id="iconTrash" /></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnUse" onAction="#onUse" text="Use Prompt" styleClass="cancel-button">
                    <graphic><Label fx:id="iconUse" /></graphic>
                </Button>
                <Button fx:id="btnSave" onAction="#onSave" text="Save Changes" styleClass="save-button">
                    <graphic><Label fx:id="iconSave" /></graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>