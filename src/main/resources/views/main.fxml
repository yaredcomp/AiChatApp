<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<BorderPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.du.et.chatapp.controllers.MainController">

    <top>
        <VBox styleClass="title-bar-container">
           <children>
               <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="12" styleClass="title-bar">
                   <padding>
                       <Insets bottom="12" left="16" right="16" top="12" />
                   </padding>
                  <children>
                      <StackPane styleClass="app-logo-container">
                         <children>
                             <ImageView fx:id="appLogoView" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
                         </children>
                      </StackPane>
                      <Label styleClass="title-2" text="DU Academia ChatAI" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="currentModelIndicator" styleClass="success" text="Loading model..." />
                      <Button fx:id="btnSettings" onAction="#onOpenSettings" styleClass="button-icon flat">
                          <graphic>
                              <Label fx:id="iconSettings" />
                          </graphic>
                          <tooltip>
                        <Tooltip text="Settings" />
                     </tooltip>
                      </Button>
                  </children>
               </HBox>
           </children>
        </VBox>
    </top>

    <left>
        <VBox fx:id="navPanel" prefWidth="280" spacing="16" styleClass="nav-panel">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
           <children>
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <children>
                      <TextField fx:id="searchField" promptText="Search chats..." HBox.hgrow="ALWAYS" />
                      <Button fx:id="navToggle" onAction="#onToggleNav" styleClass="button-icon flat">
                          <tooltip>
                        <Tooltip text="Toggle Sidebar" />
                     </tooltip>
                          <graphic>
                              <Label fx:id="iconNavToggle" />
                          </graphic>
                      </Button>
                  </children>
               </HBox>
   
               <VBox fx:id="navContent" spacing="10" VBox.vgrow="ALWAYS">
      <children>
                      <Button fx:id="btnNewChat" maxWidth="Infinity" onAction="#onNewChat" styleClass="accent" text="New Chat">
                          <graphic>
                        <Label fx:id="iconNewChat" />
                     </graphic>
                      </Button>
                      <Button fx:id="btnPrompts" maxWidth="Infinity" onAction="#onOpenPrompts" text="Prompt Library">
                          <graphic>
                        <Label fx:id="iconPrompts" />
                     </graphic>
                      </Button>
                      <Label styleClass="text-muted text-small text-bold" text="RECENT CHATS" />
                      <ListView fx:id="chatHistoryList" styleClass="chat-history-list" VBox.vgrow="ALWAYS" />
      </children>
               </VBox>
           </children>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content">
           <children>
               <StackPane VBox.vgrow="ALWAYS">
                  <children>
                      <WebView fx:id="chatWebView" />
                      
                      <VBox fx:id="emptyState" alignment="CENTER" prefHeight="547.0" prefWidth="825.0" spacing="16" styleClass="empty-state" visible="true">
                         <children>
                             <StackPane styleClass="empty-icon-container">
                                <children>
                                    <ImageView fx:id="emptyStateLogo" fitHeight="120.0" fitWidth="120.0" preserveRatio="true" StackPane.alignment="CENTER" />
                                </children>
                             </StackPane>
                             <VBox alignment="CENTER" spacing="8">
                                <children>
                                    <Label styleClass="title-2" text="Welcome to DU Academia ChatAI" />
                                    <Label styleClass="text-muted text-large" text="Developed by Dilla University CS Department" />
                                </children>
                             </VBox>
                         </children>
                      </VBox>
                  </children>
               </StackPane>
   
               <VBox alignment="TOP_CENTER" styleClass="input-area">
                   <padding>
                      <Insets bottom="20" left="40" right="40" top="0" />
                   </padding>
      <children>
                      <VBox maxWidth="800" spacing="8" styleClass="input-container">
                         <children>
                             <HBox alignment="BOTTOM_LEFT">
                                <children>
                                    <Label fx:id="typingIndicator" maxWidth="Infinity" styleClass="typing-indicator text-muted text-italic" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="charCount" styleClass="text-muted text-small" />
                                </children>
                             </HBox>
                             <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-box-wrapper">
                                <children>
                                    <TextArea fx:id="inputField" onKeyPressed="#handleInputKeyPressed" prefHeight="25.0" prefRowCount="1" prefWidth="697.0" promptText="Ask Academia ChatAI anything..." styleClass="chat-input" wrapText="true" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnSend" minHeight="40" minWidth="40" onAction="#onSendMessage" styleClass="accent">
                                        <graphic>
                                    <Label fx:id="iconSend" />
                                 </graphic>
                                    </Button>
                                </children>
                             </HBox>
                             <Label alignment="CENTER" maxWidth="Infinity" styleClass="text-muted text-small" text="AI can make mistakes. Please verify important information." />
                         </children>
                      </VBox>
      </children>
               </VBox>
           </children>
        </VBox>
    </center>
</BorderPane>
